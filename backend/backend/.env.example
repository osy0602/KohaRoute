# Copy to .env and edit. Real secrets (JWT key, ORS key) are added in later parts.
KOHA_ENV=development
# Default is a SQLite file at backend/koharoute.db.
# DATABASE_URL=sqlite:///./koharoute.db
# Comma-separated list of web origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Passwords given to the demo Admin and demo driver accounts by `python -m app.seed`.
# Demo use only. Choose your own values; they must be at least 10 characters.
# SEED_ADMIN_PASSWORD=Koha-Admin-2026!
# SEED_DRIVER_PASSWORD=Koha-Driver-2026!
