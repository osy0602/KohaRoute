# Copy this file to backend/.env and edit. Never commit the real .env file.
# Use unique signing and ORS keys outside local development.
KOHA_ENV=development

# Generate a JWT signing secret with: openssl rand -hex 32
# Required whenever KOHA_ENV is not "development" or "test".
# JWT_SECRET_KEY=

# OpenRouteService key (https://openrouteservice.org/dev/#/signup).
# Needed for address autocomplete on the booking form and for route generation.
ORS_API_KEY=

# Default is a SQLite file at backend/koharoute.db.
# DATABASE_URL=sqlite:///./koharoute.db

# Comma-separated list of web origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Passwords given to the demo Admin and demo driver accounts by `python -m app.seed`.
# Demo use only. Choose your own values; they must be at least 10 characters.
# SEED_ADMIN_PASSWORD=
# SEED_DRIVER_PASSWORD=

# Uploaded photos stay outside the frontend's public directory.
# PHOTO_STORAGE_DIR=./uploads/photos
